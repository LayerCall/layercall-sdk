{
  "name": "layercall",
  "version": "1.2.11",
  "description": "Official LayerCall client — score an IP, email, phone, domain or a whole signup for fraud in one call. Zero dependencies.",
  "keywords": [
    "fraud",
    "fraud-detection",
    "vpn-detection",
    "proxy-detection",
    "tor",
    "email-validation",
    "disposable-email",
    "phone-validation",
    "ip-lookup",
    "ip-geolocation",
    "bot-detection",
    "signup-fraud",
    "risk-score"
  ],
  "homepage": "https://www.layercall.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayerCall/layercall-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://www.layercall.com/contact"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/cjs/express.d.ts",
        "default": "./dist/cjs/express.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "bin": {
    "layercall": "dist/cli.js"
  }
}
